# Configuration shared by every node in the cluster

machine:
  type: ${machine_type}

---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: ${installer_image_url}
provisioning:
  # Single-disk Proxmox VMs (scsi0, nothing else attached) always come up as
  # /dev/sda - see terraform/examples/talos-on-proxmox/locals.tf.
  diskSelector:
    match: disk.dev_path == "/dev/sda"
  # These are already-installed, running nodes - never let this reformat the
  # system disk. Talos only (re)installs here when the installer image
  # actually changes.
  wipe: false

---
apiVersion: v1alpha1
kind: KubeletConfig
image: ghcr.io/siderolabs/kubelet:${k8s_version}

---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  topology.kubernetes.io/region: ${region}
  topology.kubernetes.io/zone: ${zone}
%{ for key, value in node_labels ~}
  ${key}: ${value}
%{ endfor ~}
%{ if length(pod_subnets) > 0 || length(service_subnets) > 0 ~}

---
apiVersion: v1alpha1
kind: KubeNetworkConfig
%{ if length(pod_subnets) > 0 ~}
podSubnets:
%{ for cidr in pod_subnets ~}
  - ${cidr}
%{ endfor ~}
%{ endif ~}
%{ if length(service_subnets) > 0 ~}
serviceSubnets:
%{ for cidr in service_subnets ~}
  - ${cidr}
%{ endfor ~}
%{ endif ~}
%{ endif ~}
